HOLABOSS_AUTH_BASE_URL=https://api.holaboss.ai
HOLABOSS_AUTH_SIGN_IN_URL=https://www.holaboss.ai/signin
HOLABOSS_BACKEND_BASE_URL=https://api.holaboss.ai
HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=https://api.holaboss.ai/gateway/sandbox

# Web frontend origin that hosts web HolaApp pages (need-review, ...) — NOT an
# api host. Web HolaApp surfaces load from <origin>/apps/<holaAppId>.
#   prod    https://www.holaos.ai
#   staging https://www.imerchstaging.com
HOLABOSS_WEB_APP_BASE_URL=https://www.holaos.ai

# Optional: where web HolaApp MCP servers are reached (SSE at
# <base>/mcp/<holaAppId>/sse). Defaults to HOLABOSS_BACKEND_BASE_URL — only set
# this if the app MCPs live on a different host than the backend/gateway.
# HOLABOSS_WEB_HOLAAPP_MCP_BASE_URL=https://api.holaos.ai

# Sentry error tracking (optional, leave empty to disable)
# SENTRY_DSN=
