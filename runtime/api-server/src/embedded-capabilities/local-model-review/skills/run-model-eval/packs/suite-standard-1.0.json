{
 "id": "suite-standard",
 "version": "1.0",
 "name": "Standard suite",
 "description": "One-click benchmark: decode speed at depth 0 and 8K, plus three program-graded tasks (code with unit tests, tool calling, 8K needle). Each task runs 3 times with the vendor's recommended sampling.",
 "num_ctx": 16384,
 "speed": {
  "depths": [
   0,
   8192
  ],
  "reps": 3,
  "warmup_reps": 1,
  "gen_tokens": 256
 },
 "samples": 3,
 "sampling": {
  "temperature": 1.0,
  "top_p": 0.95,
  "min_p": 0.0
 },
 "tasks": [
  {
   "id": "code-intervals",
   "category": "code",
   "prompt": "Write a Python function `merge_intervals(intervals: list[list[int]]) -> list[list[int]]` that merges all overlapping or touching intervals and returns them sorted by start. [1,3] and [3,5] touch and merge.\n\nReturn the complete function in a single ```python code block. No tests, no I/O.",
   "max_tokens": 8000,
   "grader": {
    "type": "python_tests",
    "tests": "assert merge_intervals([]) == []\nassert merge_intervals([[1,3],[2,6],[8,10],[15,18]]) == [[1,6],[8,10],[15,18]]\nassert merge_intervals([[1,4],[4,5]]) == [[1,5]]\nassert merge_intervals([[5,7],[1,2]]) == [[1,2],[5,7]]\nassert merge_intervals([[1,10],[2,3],[4,5]]) == [[1,10]]"
   }
  },
  {
   "id": "tool-flight",
   "category": "tool",
   "prompt": "Find me flights from San Francisco (SFO) to Tokyo on November 3, 2026.",
   "tools": [
    {
     "type": "function",
     "function": {
      "name": "search_flights",
      "description": "Search one-way flights.",
      "parameters": {
       "type": "object",
       "properties": {
        "origin": {
         "type": "string",
         "description": "IATA airport or city code"
        },
        "destination": {
         "type": "string",
         "description": "IATA airport or city code"
        },
        "date": {
         "type": "string",
         "description": "YYYY-MM-DD"
        }
       },
       "required": [
        "origin",
        "destination",
        "date"
       ]
      }
     }
    },
    {
     "type": "function",
     "function": {
      "name": "book_hotel",
      "description": "Book a hotel room.",
      "parameters": {
       "type": "object",
       "properties": {
        "city": {
         "type": "string"
        },
        "check_in": {
         "type": "string"
        },
        "nights": {
         "type": "integer"
        }
       },
       "required": [
        "city",
        "check_in",
        "nights"
       ]
      }
     }
    }
   ],
   "grader": {
    "type": "tool_call",
    "name": "search_flights",
    "args": {
     "origin": {
      "equals_ci": "SFO"
     },
     "destination": {
      "one_of_ci": [
       "TYO",
       "NRT",
       "HND"
      ]
     },
     "date": {
      "equals": "2026-11-03"
     }
    }
   },
   "max_tokens": 6000
  },
  {
   "id": "needle-8k",
   "category": "long_context",
   "prompt": "Question: What is the secret passcode for the blue vault? Answer with the passcode only.",
   "haystack": {
    "approx_tokens": 8000,
    "needle": "The secret passcode for the blue vault is 7391-QX.",
    "depth": 0.5
   },
   "grader": {
    "type": "contains",
    "value": "7391-QX"
   },
   "max_tokens": 6000
  }
 ]
}
